# Copy this file to .env and replace placeholders locally.
# Never commit .env or real secret values.

# Database
DATABASE_URL=sqlite:///./data/ai_study_buddy.db

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini (backend only)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=replace-with-gemini-model-name

# Local URLs
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:8501

# Upload and prompt limits
MAX_UPLOAD_MB=5
MAX_SOURCE_CHARS=30000
